{
  "builds": [
    {
      "src": "core/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/frontend/account/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "core/wsgi.py"
    },
    {
      "source": "/admin/(.*)",
      "destination": "core/wsgi.py"
    }
  ]
}