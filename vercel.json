{
  "redirects": [
    {
      "source": "/",
      "destination": "/account/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "core/wsgi.py"
    },
    {
      "source": "/admin/(.*)",
      "destination": "core/wsgi.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "core/wsgi.py"
    }
  ]
}